{
  "name": "client-portal-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare:next": "next build --webpack",
    "build:cloudflare": "npm run build:cloudflare:next && opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "lint": "eslint .",
    "dev:https": "set \"NODE_EXTRA_CA_CERTS=%LOCALAPPDATA%\\mkcert\\rootCA.pem\" && node server.js",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview -- --port 3000",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --runInBand --passWithNoTests --coverage=false --ci",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run test:ci && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.9",
    "express": "^5.2.1",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5",
    "wrangler": "^4.90.1"
  }
}
